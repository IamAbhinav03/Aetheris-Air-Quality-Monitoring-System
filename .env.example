# =============================================================================
# Aetheris environment configuration
# Copy this file to `.env` and change every password.
# `scripts/setup.sh` / `scripts/setup.ps1` do this for you.
# =============================================================================

# Timezone used by containers (IANA name, e.g. Asia/Kolkata, Europe/Berlin)
TZ=UTC

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
# Port on the host that serves the Grafana UI
GRAFANA_PORT=3000

# --- MQTT (Mosquitto) --------------------------------------------------------
# These credentials are also written into the ESPHome secrets file.
MQTT_USERNAME=aetheris
MQTT_PASSWORD=change-me-please
MQTT_PORT=1883

# --- Admin-only ports --------------------------------------------------------
# These are bound to 127.0.0.1 and are not reachable from other machines.
INFLUXDB_PORT=8181
LOKI_PORT=3100
ALLOY_PORT=12345
EXPLORER_PORT=8888
PORTAINER_PORT=9000
